{
  "name": "ui-site",
  "private": true,
  "version": "0.4.27",
  "type": "module",
  "scripts": {
    "sync:installer": "cp ../install.sh public/install.sh",
    "predev": "npm run sync:installer",
    "dev": "vite",
    "functions:typecheck": "tsc -p ../functions/tsconfig.json",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "prebuild": "npm run sync:installer",
    "build": "npm run functions:typecheck && vite build && vite build --ssr src/entry-server.ts --outDir .ssr --emptyOutDir && node scripts/prerender.mjs && vitepress build docs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@tailwindcss/vite": "^4.3.0",
    "markdown-it": "^15.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260818.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4"
  }
}
