{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@fluxo/*": ["../ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../ui/src/**/*.ts", "../ui/src/**/*.vue"]
}
